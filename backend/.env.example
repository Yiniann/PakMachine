DATABASE_URL="mysql://root:1201@localhost:3306/pacmachine"
PORT=3000
JWT_SECRET="replace-me"
# Base URL that前端承载重置密码页，用于拼接重置链接（默认 http://localhost:5173/auth/reset）
PASSWORD_RESET_BASE_URL="http://localhost:5173/auth/reset"

# Private client-package R2 bucket. The backend only returns short-lived signed download URLs.
CLIENT_R2_ACCOUNT_ID=""
CLIENT_R2_ACCESS_KEY_ID=""
CLIENT_R2_SECRET_ACCESS_KEY=""
CLIENT_R2_BUCKET=""

# Optional override for the dedicated client workflow file. Repo and branch come from the selected admin template.
CLIENT_GITHUB_WORKFLOW_FILE="package-client.yml"
