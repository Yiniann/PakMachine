generator client {
  provider      = "prisma-client-js"
  // Include linux engines so Prisma Client works on Debian/Ubuntu hosts even if built on mac
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int       @id @default(autoincrement())
  email                String    @unique
  password             String
  emailVerified        Boolean   @default(false)
  role                 String    @default("user") // "user" | "admin"
  userType             String    @default("pending") // "pending" | "basic" | "pro"
  siteName             String?
  siteNameLimit        Int       @default(1)
  frontendOriginsLimit Int       @default(4)
  frontendOriginsJson  String?   @db.Text
  buildQuotaUsed       Int       @default(0) // 当天已使用的构建次数
  buildQuotaDate       DateTime?
  resetToken           String?
  resetTokenExpires    DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // 打包相关关联
  buildJobs              BuildJob[]
  buildProfile           BuildProfile?
  buildArtifacts         BuildArtifact[]
  clientAppConfigs       ClientAppConfig[]
  sites                  UserSite[]
  frontendOrigins        FrontendOrigin[]
  supportTickets         SupportTicket[]
  ticketMessagesAuthored SupportTicketMessage[] @relation("SupportTicketMessagesAuthored")
}

model VerificationCode {
  id           Int       @id @default(autoincrement())
  email        String
  codeHash     String
  purpose      String    @default("register")
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  consumedAt   DateTime?
  attemptCount Int       @default(0)

  @@index([email])
  @@index([purpose, email])
}

/// 管理员上传的模板（一个 zip 文件）
model Template {
  id          Int      @id @default(autoincrement())
  name        String // 模板名称
  description String? // 模板描述
  filePath    String // 模板 zip 在服务器上的路径
  envSchema   String? // JSON: ["VITE_API_URL","VITE_TITLE", ...]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

/// 每一次打包任务（独立 env + 独立产物文件）
model BuildJob {
  id               Int       @id @default(autoincrement())
  userId           Int
  siteId           Int?
  siteNameSnapshot String?
  buildKind        String    @default("web") // "web" | "client"
  platform         String?
  arch             String?
  version          String?
  filename         String
  status           String // "pending" | "running" | "success" | "failed"
  envJson          String    @db.LongText // 本次打包使用的 env 快照 JSON
  artifactId       Int?
  objectKey        String?
  artifactFilename String?
  artifactSize     Int?
  artifactSha256   String?
  githubRunId      String?
  expiresAt        DateTime?
  message          String?   @db.Text // 构建日志 / 错误信息（可选）
  createdAt        DateTime  @default(now())

  user User      @relation(fields: [userId], references: [id])
  site UserSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([userId, buildKind, createdAt])
}

/// 用户常用的构建配置（站点信息、IDHub、客户端下载链接等）
model BuildProfile {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

/// 每个用户品牌对应的稳定客户端身份。应用名称可变，appId 永久保持不变。
model ClientAppConfig {
  id                Int      @id @default(autoincrement())
  userId            Int
  siteId            Int?
  brandKey          String
  brandNameSnapshot String
  appId             String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  site UserSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@unique([userId, brandKey])
  @@index([siteId])
}

/// 构建产物元数据，用于绑定下载权限
model BuildArtifact {
  id             Int      @id @default(autoincrement())
  userId         Int
  sourceFilename String
  outputPath     String
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model UserSite {
  id                   Int      @id @default(autoincrement())
  userId               Int
  name                 String
  frontendOriginsLimit Int      @default(4)
  clientBuildEnabled   Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  buildJobs        BuildJob[]
  clientAppConfigs ClientAppConfig[]
  frontendOrigins  SiteFrontendOrigin[]

  @@unique([userId, name])
  @@index([userId, createdAt])
}

model FrontendOrigin {
  id        Int      @id @default(autoincrement())
  userId    Int
  origin    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  sites SiteFrontendOrigin[]

  @@unique([userId, origin])
  @@index([userId, createdAt])
}

model SiteFrontendOrigin {
  siteId    Int
  originId  Int
  createdAt DateTime @default(now())

  site           UserSite       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  frontendOrigin FrontendOrigin @relation(fields: [originId], references: [id], onDelete: Cascade)

  @@id([siteId, originId])
  @@index([originId])
}

model SupportTicket {
  id         Int       @id @default(autoincrement())
  userId     Int
  subject    String
  category   String    @default("general")
  content    String    @db.Text
  status     String    @default("open") // "open" | "processing" | "closed"
  adminReply String?   @db.Text
  closedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User                   @relation(fields: [userId], references: [id])
  messages SupportTicketMessage[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model SupportTicketMessage {
  id         Int      @id @default(autoincrement())
  ticketId   Int
  authorId   Int?
  senderRole String
  content    String   @db.Text
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation("SupportTicketMessagesAuthored", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([authorId])
}
